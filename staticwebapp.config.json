{
  "platform": { "apiRuntime": "node:22" },
  "routes": [
    { "route": "/", "rewrite": "/sprachpraxis-c1.html" },
    { "route": "/admin.html", "allowedRoles": ["administrator"] },
    { "route": "/api/progress", "allowedRoles": ["authenticated"] },
    { "route": "/api/tts", "allowedRoles": ["authenticated"] },
    { "route": "/api/sentences", "methods": ["POST"], "allowedRoles": ["administrator"] }
  ],
  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/.auth/login/github" }
  }
}
